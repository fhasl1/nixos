{
	"layer": "top",
	"margin-top": 10,
	"width": 500,
	// "modules-left": ["clock"],
	"modules-center": ["custom/clock", "sway/workspaces", "battery", "tray"],
	// "modules-right": ["tray"],
	"sway/workspaces" : {
		"format": "{name}",
		"persistent-workspaces": {
			"1": [],
			"2": [],
			"3": [],
			"4": [],
			"5": [],
		}
	},
	"custom/clock": {
		"exec": "date '+%I:%M %P'",
		"interval": 1
	},
	"tray": {
		"icon-size": 16,
		"spacing": 10
	},
	"battery": {
		"bat": "BAT1",
		"interval": 60,
		"states": {
			"warning": 30,
			"critical": 15
		},
		"format": "{capacity}% {icon}",
		"format-icons": {
			"charging": ["󱐋"]
		},
		"max-length": 25
	}
}
